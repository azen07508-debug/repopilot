{
  "name": "repopilot",
  "version": "0.1.0-rc.2",
  "private": true,
  "description": "RepoPilot — GitHub repository launch-readiness audit service for AI Agents and Web3 developers",
  "license": "MIT",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "build:core": "pnpm --filter @repopilot/core build",
    "build:okx": "pnpm --filter @repopilot/okx-adapter build",
    "build:mcp": "pnpm --filter @repopilot/mcp-server build",
    "build:api": "pnpm --filter @repopilot/api build",
    "build:web": "pnpm --filter @repopilot/web build",
    "dev": "pnpm -r --parallel --filter './apps/*' --filter './packages/*' dev",
    "dev:api": "pnpm --filter @repopilot/api dev",
    "dev:web": "pnpm --filter @repopilot/web dev",
    "start": "pnpm --filter @repopilot/api start",
    "mcp": "pnpm --filter @repopilot/mcp-server start",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @repopilot/core test",
    "test:okx": "pnpm --filter @repopilot/okx-adapter test",
    "test:mcp": "pnpm --filter @repopilot/mcp-server test",
    "test:api": "pnpm --filter @repopilot/api test",
    "lint": "tsx scripts/lint.ts",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @repopilot/api db:generate",
    "db:migrate": "pnpm --filter @repopilot/api db:migrate",
    "db:seed": "pnpm --filter @repopilot/api db:seed",
    "env:check": "tsx scripts/env-check.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "docker:check": "bash scripts/docker-check.sh",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "compose:check": "tsx scripts/compose-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yaml": "^2.9.0"
  }
}
