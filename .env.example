# =============================================================================
# RepoPilot — Environment configuration
# Copy to `.env` and adjust. Never commit real secrets.
#
# Run `pnpm env:check` to validate this file against the current
# NODE_ENV / PAYMENT_MODE. The script never prints secret values.
# =============================================================================

# ---- Runtime mode ----
# development | test | production
NODE_ENV=development

# ---- Server ----
# Port and host the API binds to.
PORT=4000
HOST=0.0.0.0

# ---- Logging ----
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- CORS ----
# Comma separated list of allowed origins. Never use "*" in production.
# Default below is safe for local dev only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
# Local dev: a file path. Production: a postgres:// URL.
# Sqlite is fine for development and small deployments.
DATABASE_URL=file:./data/repopilot.db
# Example Postgres URL (replace with real credentials in production):
# DATABASE_URL=postgres://repopilot:CHANGE_ME@localhost:5432/repopilot

# ---- GitHub token (optional but recommended) ----
# Without a token: 60 req/h unauthenticated. With a token: 5000 req/h.
# Use a fine-grained token with `public_repo` read scope only.
# Never commit the value.
GITHUB_TOKEN=

# ---- Allowed repository hosts (URL allowlist / SSRF defence) ----
# Comma separated. Anything outside this list is rejected.
ALLOWED_REPO_HOSTS=github.com,raw.githubusercontent.com

# ---- Limits ----
MAX_FILES=2000
MAX_FILE_BYTES=1048576
MAX_TOTAL_BYTES=52428800
FETCH_TIMEOUT_MS=30000
JOB_TIMEOUT_MS=300000
ANALYSIS_TIMEOUT_MS=120000
RATE_LIMIT_PER_MINUTE=60

# ---- Payment mode ----
# mock = in-process mock adapter (default; safe for dev)
# okx  = OKX Agent Payments Protocol (x402 + EIP-3009). Requires OKX.AI Beta.
#        See docs/EXTERNAL_ACTIONS.md before flipping this in production.
PAYMENT_MODE=mock

# ---- OKX payment config (only used when PAYMENT_MODE=okx) ----
# 0x-prefixed EVM address that receives USDT on the chosen network.
OKX_PAYMENT_ADDRESS=
# xlayer | ethereum | base | arbitrum | bsc
OKX_PAYMENT_NETWORK=xlayer
# 1 (legacy) or 2 (current x402 v2)
OKX_X402_VERSION=2

# ---- Pricing (USDT) ----
# Editable here. The pipeline never hard-codes a number.
PRICE_QUICK_SCAN=0.02
PRICE_FULL_AUDIT=0.10

# ---- Report cache (paid audits only) ----
# Off by default. When enabled, the API caches paid audit reports
# keyed by (owner, repo, commit SHA, mode, target, outputLanguage,
# reportVersion, includeLaunchCopy). Cache hits never bypass payment.
REPORT_CACHE_ENABLED=false
REPORT_CACHE_TTL_SECONDS=3600

# ---- Audit queue (paid audits) ----
# 'inline'  : in-process scheduler (SQLite / tests / verify:release)
# 'pg-boss' : persistent PostgreSQL-backed queue (production)
# Production refuses to start with AUDIT_QUEUE_DRIVER=inline; the
# config validator and env:check both enforce this.
AUDIT_QUEUE_DRIVER=inline
AUDIT_QUEUE_CONCURRENCY=1
AUDIT_QUEUE_RETRY_LIMIT=1
AUDIT_QUEUE_JOB_TIMEOUT_MS=300000

# ---- Graceful shutdown ----
# How long the server waits for in-flight audit jobs to drain before
# forcing the queue and the database connection closed.
SHUTDOWN_GRACE_PERIOD_MS=30000

# ---- LLM provider (optional upgrade) ----
# noop  = templates only (default, zero cost)
# openai-compatible = any OpenAI-style chat completion endpoint
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ---- OKX.AI marketplace listing (optional) ----
# Only required if you want to publish RepoPilot to the OKX.AI Agent
# Marketplace. Not needed for self-hosted use.
OKX_ASP_AGENT_ID=
OKX_ASP_RECIPIENT_ADDRESS=

# =============================================================================
# Notes
# =============================================================================
# * `pnpm env:check` validates this file. It never prints the values
#   of any var whose name suggests a secret (GITHUB_TOKEN, OKX_*_KEY /
#   _SECRET, LLM_API_KEY, *_API_KEY, SECRET, PRIVATE_KEY, MNEMONIC).
# * In production, the absence of CORS_ORIGINS or its value "*" causes
#   `pnpm env:check` to fail.
# * In production, PAYMENT_MODE=mock causes `pnpm env:check` to fail.
# * OKX_PAYMENT_ADDRESS is a 0x-prefixed EVM address; the script
#   verifies the format but cannot verify that you have Beta access.
# =============================================================================
